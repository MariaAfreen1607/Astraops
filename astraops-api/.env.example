# AstraOps API — environment configuration
# Copy this file to .env and fill in your values.

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="AstraOps API"
APP_VERSION="0.1.0"
DEBUG=false

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (JSON array format for pydantic-settings)
CORS_ORIGINS='["http://localhost:3000"]'

# ── IBM Watsonx (RAG pipeline) ───────────────────────────────────────────────
# Get credentials at https://cloud.ibm.com/
WATSONX_APIKEY=your-ibm-cloud-api-key
WATSONX_PROJECT_ID=your-watsonx-project-id
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── CelesTrak ────────────────────────────────────────────────────────────────
CELESTRAK_GP_URL=https://celestrak.org/gp.php

# ── NASA DONKI ───────────────────────────────────────────────────────────────
NASA_DONKI_BASE_URL=https://kauai.ccmc.gsfc.nasa.gov/DONKI/WS/get
# Get a free key at https://api.nasa.gov — DEMO_KEY is rate-limited (30 req/hr)
NASA_API_KEY=DEMO_KEY

# ── Cache TTLs (seconds) ──────────────────────────────────────────────────────
TLE_CACHE_TTL=3600
SPACEWEATHER_CACHE_TTL=900
CONJUNCTION_CACHE_TTL=1800

# ── HTTP client ───────────────────────────────────────────────────────────────
HTTP_TIMEOUT=30.0
